!.env.example
*.local
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.token
*.credentials
*secret*
*service_role*
*service-account*.json
credentials.json
secrets.json

# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged

# Next.js & Build Outputs
.next/
out/
build/
dist/

# TypeScript & Caches
*.tsbuildinfo
next-env.d.ts
.turbo/

# Testing & Coverage
coverage/
*.lcov
.nyc_output

# Debug & Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Vercel & Deployment
.vercel/

# OS & Editor Files
.DS_Store
.DS_Store?
._*
